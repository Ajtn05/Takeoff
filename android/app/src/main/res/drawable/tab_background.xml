<?xml version='1.0' encoding='utf-8'?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#335A8070">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="@color/accent_panel" />
                    <stroke android:width="1dp" android:color="#476359" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@android:color/transparent" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>