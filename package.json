{
  "name": "drone-photography-trainer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:lan": "HOST=0.0.0.0 tsx server/index.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "npm run check && vite build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist-server/server/index.js",
    "start:lan": "HOST=0.0.0.0 npm start",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:hosted": "playwright test --config playwright.hosted.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "three": "0.186.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/qrcode": "1.5.6",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
