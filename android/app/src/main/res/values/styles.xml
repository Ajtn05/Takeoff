<resources>
    <style name="PairingScanTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="RemoteText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="RemoteText.Body" parent="RemoteText">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="RemoteText.Title" parent="RemoteText">
        <item name="android:textSize">25sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="RemoteText.Section" parent="RemoteText">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="RemoteText.Label" parent="RemoteText">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="RemoteText.Mono" parent="RemoteText.Body">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">monospace</item>
    </style>
    <style name="RemoteText.Metric" parent="RemoteText">
        <item name="android:textSize">19sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="RemoteCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/panel_background</item>
        <item name="android:layout_marginTop">14dp</item>
    </style>
    <style name="RemoteButton" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:singleLine">false</item>
        <item name="android:maxLines">2</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/button_secondary_text</item>
        <item name="android:drawableTint">@color/button_secondary_text</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="RemoteButton.Primary" parent="RemoteButton">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="android:drawableTint">@color/button_primary_text</item>
    </style>
    <style name="RemoteButton.Tab" parent="RemoteButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:background">@drawable/tab_background</item>
        <item name="android:textColor">@color/tab_text</item>
        <item name="android:drawableTint">@color/tab_text</item>
    </style>
    <style name="RemoteButton.Quiet" parent="RemoteButton">
        <item name="android:background">@drawable/button_quiet</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:drawableTint">@color/accent</item>
    </style>
</resources>
