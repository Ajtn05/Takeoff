<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/controls_screen" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingTop="10dp" android:paddingBottom="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/mode_caption" style="@style/RemoteText.Body" android:text="RC231 · Mode 2" android:layout_width="0dp" android:layout_weight="1" />
            <TextView android:id="@+id/controls_state" style="@style/RemoteText.Label" android:layout_width="wrap_content" android:text="OFFLINE" android:paddingHorizontal="10dp" android:paddingVertical="8dp" android:background="@drawable/status_background" android:textColor="@color/text_secondary" android:letterSpacing="0.04" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp" android:baselineAligned="false">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.1" android:orientation="vertical" android:layout_marginEnd="14dp">
                <LinearLayout style="@style/RemoteCard" android:padding="10dp" android:layout_marginTop="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/RemoteText.Label" android:text="ALTITUDE" android:textSize="9sp" android:letterSpacing="0.06" />
                            <TextView android:id="@+id/altitude_value" style="@style/RemoteText.Metric" android:text="—" android:layout_marginTop="6dp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/RemoteText.Label" android:text="SPEED" android:textSize="9sp" android:letterSpacing="0.06" />
                            <TextView android:id="@+id/speed_value" style="@style/RemoteText.Metric" android:text="—" android:layout_marginTop="6dp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/RemoteText.Label" android:text="HEADING" android:textSize="9sp" android:letterSpacing="0.06" />
                            <TextView android:id="@+id/heading_value" style="@style/RemoteText.Metric" android:text="—" android:layout_marginTop="6dp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/RemoteText.Label" android:text="CAMERA" android:textSize="9sp" android:letterSpacing="0.06" />
                            <TextView android:id="@+id/camera_value" style="@style/RemoteText.Metric" android:text="—" android:layout_marginTop="6dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout style="@style/RemoteCard" android:padding="10dp" android:layout_marginTop="10dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="10dp">
                            <TextView style="@style/RemoteText.Label" android:text="LEFT STICK" android:gravity="center" />
                            <TextView android:id="@+id/left_axes" style="@style/RemoteText.Body" android:text="Altitude / yaw" android:gravity="center" android:textSize="12sp" android:layout_marginTop="5dp" />
                            <com.takeoff.rc231.StickView android:id="@+id/left_stick" android:layout_width="match_parent" android:layout_height="94dp" android:layout_marginTop="4dp" />
                            <TextView android:id="@+id/left_values" style="@style/RemoteText.Mono" android:text="No readings" android:gravity="center" android:textSize="10sp" android:minLines="2" android:visibility="gone" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/RemoteText.Label" android:text="RIGHT STICK" android:gravity="center" />
                            <TextView android:id="@+id/right_axes" style="@style/RemoteText.Body" android:text="Forward / strafe" android:gravity="center" android:textSize="12sp" android:layout_marginTop="5dp" />
                            <com.takeoff.rc231.StickView android:id="@+id/right_stick" android:layout_width="match_parent" android:layout_height="94dp" android:layout_marginTop="4dp" />
                            <TextView android:id="@+id/right_values" style="@style/RemoteText.Mono" android:text="No readings" android:gravity="center" android:textSize="10sp" android:minLines="2" android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:layout_marginBottom="12dp" android:background="@color/line" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView style="@style/RemoteText.Label" android:text="CAMERA DIAL" android:layout_width="0dp" android:layout_weight="1" />
                        <TextView android:id="@+id/dial_value" style="@style/RemoteText.Mono" android:text="No readings" android:layout_width="wrap_content" />
                    </LinearLayout>
                    <com.takeoff.rc231.DialView android:id="@+id/camera_dial" android:layout_width="match_parent" android:layout_height="22dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView style="@style/RemoteText.Body" android:text="Tilt down" android:layout_width="0dp" android:layout_weight="1" android:textSize="11sp" />
                        <TextView style="@style/RemoteText.Body" android:text="Tilt up" android:layout_width="wrap_content" android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/enable_reason" style="@style/RemoteText.Body" android:text="Pair the laptop first." android:layout_marginTop="0dp" android:accessibilityLiveRegion="polite" />
                <Button android:id="@+id/enable" style="@style/RemoteButton.Primary" android:text="Enable controls" android:layout_marginTop="8dp" />
                <Button android:id="@+id/controls_setup" style="@style/RemoteButton.Quiet" android:text="Go to setup" android:layout_marginTop="8dp" />
                <TextView style="@style/RemoteText.Label" android:text="FLIGHT ACTIONS" android:layout_marginTop="16dp" android:layout_marginBottom="10dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <Button android:id="@+id/takeoff" style="@style/RemoteButton" android:text="Take off" android:layout_width="0dp" android:layout_weight="1" android:drawableStart="@drawable/ic_takeoff_action" android:enabled="false" android:layout_marginEnd="10dp" />
                    <Button android:id="@+id/land" style="@style/RemoteButton" android:text="Land" android:layout_width="0dp" android:layout_weight="1" android:drawableStart="@drawable/ic_land" android:enabled="false" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <Button android:id="@+id/capture" style="@style/RemoteButton" android:text="Capture photo" android:layout_width="0dp" android:layout_weight="1" android:drawableStart="@drawable/ic_camera" android:enabled="false" android:layout_marginEnd="10dp" />
                    <Button android:id="@+id/resume" style="@style/RemoteButton" android:text="Resume game" android:layout_width="0dp" android:layout_weight="1" android:drawableStart="@drawable/ic_play" android:enabled="false" />
                </LinearLayout>
                <TextView android:id="@+id/message" style="@style/RemoteText.Body" android:text="Center the sticks before enabling." android:layout_marginTop="2dp" android:accessibilityLiveRegion="polite" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout style="@style/RemoteCard">
            <TextView style="@style/RemoteText.Label" android:text="REMOTE BUTTON GUIDE" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
                <TextView style="@style/RemoteText.Body" android:text="Shutter / record" android:layout_width="0dp" android:layout_weight="1" android:textSize="12sp" />
                <TextView style="@style/RemoteText.Body" android:text="Capture photo" android:layout_width="wrap_content" android:textSize="12sp" android:textColor="@color/text_primary" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
                <TextView style="@style/RemoteText.Body" android:text="Return to home" android:layout_width="0dp" android:layout_weight="1" android:textSize="12sp" />
                <TextView style="@style/RemoteText.Body" android:text="Land here" android:layout_width="wrap_content" android:textSize="12sp" android:textColor="@color/text_primary" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
                <TextView style="@style/RemoteText.Body" android:text="Pause" android:layout_width="0dp" android:layout_weight="1" android:textSize="12sp" />
                <TextView style="@style/RemoteText.Body" android:text="Pause controls" android:layout_width="wrap_content" android:textSize="12sp" android:textColor="@color/text_primary" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
                <TextView style="@style/RemoteText.Body" android:text="Fn + mode switch" android:layout_width="0dp" android:layout_weight="1" android:textSize="12sp" />
                <TextView style="@style/RemoteText.Body" android:text="Monitor only" android:layout_width="wrap_content" android:textSize="12sp" android:textColor="@color/text_primary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>